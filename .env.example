# .env.example for UNIA
# Follows strict Easypanel guidelines: no empty/ghost values.

# Server Configuration
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
# Use the same network/host provided by Easypanel
DB_HOST=unia-db
DB_PORT=5432
DB_USER=unia_admin
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DB_NAME=unia_prm

# Authentication
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# WhatsApp OTP (Evolution API - mesma infra do Nosso Templo)
EVOLUTION_API_URL=https://pracy-evolution-api.vrdrcy.easypanel.host
EVOLUTION_INSTANCE=PracyAT2
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY_HERE

# IA - OmniRoute (provedor principal, OpenAI-compatible)
OMNIROUTE_BASE_URL=https://omniroute-omniroute-app.vrdrcy.easypanel.host/v1
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_KEY_HERE
OMNIROUTE_MODEL=free-stack

# IA - DeepSeek (fallback opcional; deixe vazio se nao usar)
DEEPSEEK_API_KEY=

# Cron de lembretes WhatsApp (disparo manual protegido por este segredo)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Deploy Settings
ENABLE_REGISTRATION=true
ENABLE_AI_MEDIATOR=true
